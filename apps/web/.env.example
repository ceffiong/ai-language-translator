# Copy to apps/web/.env.local and fill in. Never commit real values.

# MongoDB Atlas connection string (include the database name, e.g. /ai_translator)
MONGODB_URI=

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Web application client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (magic-link emails). onboarding@resend.dev only delivers to your own Resend account email.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# DeepL. Free keys end in ":fx" and use https://api-free.deepl.com
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com

# Anthropic (Claude explanations)
ANTHROPIC_API_KEY=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Comma-separated extension IDs allowed to call the API (Chrome + Firefox, dev + prod)
EXTENSION_IDS=

# Free-tier explanations per day. Set at launch; never lower it afterwards.
ANON_DAILY_LIMIT=30
